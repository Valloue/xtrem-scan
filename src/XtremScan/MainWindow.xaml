<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XtremScan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xtrem Scan">
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="LeftCompact"
        IsPaneOpen="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        Loaded="Nav_Loaded"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Scanner" Tag="scan">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Camera" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Réglages" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="À propos" Tag="about">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
