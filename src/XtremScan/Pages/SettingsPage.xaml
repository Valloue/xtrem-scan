<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XtremScan.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Réglages" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock
            TextWrapping="Wrap"
            Text="Le dossier est demandé quand tu enregistres le PDF, ou quand tu lances un scan JPEG, PNG ou TIFF." />
        <TextBlock
            TextWrapping="Wrap"
            Text="La reconnaissance de texte se lance depuis Scanner, avec le bouton Reconnaître le texte. Une fenêtre montre alors le chargement." />
        <TextBlock
            Opacity="0.8"
            TextWrapping="Wrap"
            Text="Le dernier scanner, le format, la résolution et la couleur sont repris au prochain lancement." />
    </StackPanel>
</Page>
